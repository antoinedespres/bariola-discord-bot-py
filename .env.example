# Copy this file to .env and fill in the values.

# Discord Application -> Bot -> Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Command prefix for legacy prefix-style invocation (slash commands work regardless)
BOT_PREFIX=$

# Optional: a test/dev guild ID for fast slash-command sync during development.
# Leave unset in production; only used by the owner-only `sync` command.
DEV_GUILD_ID=
